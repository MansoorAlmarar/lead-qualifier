# Server-side only. Never prefix with NEXT_PUBLIC_.
# Local: Development key (tr_dev_...). Vercel: Production key (tr_prod_...).
TRIGGER_SECRET_KEY=

# Supabase (Project Settings -> API). The publishable key is safe in the browser;
# row-level security protects the data. Never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe (test mode first). Secret key: Developers -> API keys. Server-side only.
STRIPE_SECRET_KEY=
# Webhook signing secret. Local: printed by `stripe listen`. Production: from the webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=
# Price ID of the monthly Pro price (price_...). Not secret, but differs between test and live.
STRIPE_PRICE_ID=

# Supabase secret key (Project Settings -> API). Server-side only, used by billing code. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
